{
  "name": "service-desk-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "sync": "node scripts/sync-data.mjs",
    "build": "npm run sync && vite build && wrangler deploy --dry-run --outdir .test-build",
    "typecheck": "tsc --noEmit",
    "test": "npm run sync && node --test tests/*.test.mjs",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "dev": "npm run build && npm run db:migrate && wrangler dev --local --ip 127.0.0.1 --port 8787 --var APP_ENV:local --var LOCAL_DEV_IDENTITY:enabled",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "jose": "^6.2.12",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260908.1",
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "miniflare": "^5.20260908.0-alpha",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "wrangler": "^4.130.0"
  },
  "overrides": {
    "sharp": "0.35.4"
  }
}
