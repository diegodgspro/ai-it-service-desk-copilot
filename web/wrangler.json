{
  "name": "deskpilot",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-09",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "vars": {
    "APP_ENV": "production",
    "LOCAL_DEV_IDENTITY": "disabled",
    "APP_ORIGIN": "https://deskpilot.diegodgspro.workers.dev",
    "AUTH0_AUDIENCE": "https://deskpilot-api"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "deskpilot-production",
      "database_id": "ef95d7b5-1f4f-40f2-9f0d-c211a5dfc7e7",
      "migrations_dir": "migrations"
    }
  ],
  "workers_dev": true,
  "preview_urls": false
}
